{
  "name": "prostar-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Prostar view-only Mac screen agent",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prebuild": "node scripts/clean-dist.mjs",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts dashboard/tests/*.test.ts",
    "start": "npm run build --silent && node dist/server.js",
    "tunnel": "tsx src/tunnel-cli.ts",
    "admin": "bash scripts/prostar-admin.sh",
    "install-agent": "bash scripts/install-agent.sh",
    "uninstall-agent": "bash scripts/uninstall-agent.sh"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "express": "^4.21.2",
    "sharp": "^0.35.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "@types/ws": "^8.5.14",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
