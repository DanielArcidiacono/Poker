# Required: password to open the viewer
VIEWER_PASSWORD=change-me

# HTTP port (default 8787)
PORT=8787

# Capture settings
FPS=8
JPEG_QUALITY=60
SCALE=0.5
# DISPLAY_ID=0

# Pair with the dashboard (stable watch URL = CONTROL_PLANE_URL/watch)
# CONTROL_PLANE_URL=http://10.0.0.2:3000
# AGENT_TOKEN=same-secret-as-dashboard
# CORS_ORIGINS=http://10.0.0.2:3000,http://localhost:3000
# Auto-publish a tunnel URL to the dashboard when the agent starts
# SHARE_ON_START=1

# Optional: named Cloudflare tunnel for a fixed hostname (not trycloudflare.com)
# CLOUDFLARED_TOKEN=
# CLOUDFLARED_CONFIG=
# AUTO_TUNNEL=0
