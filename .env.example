# Required: password to open the viewer
VIEWER_PASSWORD=change-me

# HTTP port (default 8787)
PORT=8787

# Capture settings
FPS=8
JPEG_QUALITY=60
SCALE=0.5
# DISPLAY_ID=0

# Optional: pair with the Vercel dashboard
# CONTROL_PLANE_URL=https://your-app.vercel.app
# AGENT_TOKEN=same-secret-as-dashboard
# CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# Optional: run cloudflared as a child of the server (named tunnel token preferred)
# CLOUDFLARED_TOKEN=
# CLOUDFLARED_CONFIG=
# AUTO_TUNNEL=0
