# Required: password to open Prostar directly
PROSTAR_VIEWER_PASSWORD=change-me

# HTTP port (default 8787)
PORT=8787

# Capture settings
FPS=8
JPEG_QUALITY=60
SCALE=0.5
MAX_WIDTH=1920
# DISPLAY_ID=0

# Pair with the dashboard (stable watch URL = CONTROL_PLANE_URL/watch)
# CONTROL_PLANE_URL=http://10.0.0.2:3000
# Legacy installs only. New dashboard installs receive a scoped Prostar secret.
# AGENT_TOKEN=same-secret-as-dashboard
# PROSTAR_CLIENT_ID=generated-during-dashboard-setup
# PROSTAR_AGENT_SECRET=generated-during-dashboard-setup
# PROSTAR_CLOUDFLARED_BIN is managed automatically by installed releases.

# Optional: start a quick tunnel without the dashboard
# AUTO_TUNNEL=0
